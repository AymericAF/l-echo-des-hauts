---
/**
 * `/article/[slug]` — la page article francaise (§4.2).
 *
 * Fichier de ROUTE : il n emet que des chemins et remet le rendu a `PageArticle`, que
 * `/en/article/[slug]` partage. La regle du lot : une route sait ce qu elle emet, un
 * composant sait ce qu il affiche, et le REGISTRE sait ce qui existe.
 *
 * Le slug est celui de la locale francaise. Sa contrepartie anglaise se lit dans les
 * `localizations` de l entree, jamais par prefixage (T-05, piege 1) — c est le layout
 * qui s en charge, a partir du descripteur passe ci-dessous.
 *
 * LE LAYOUT NE RECOIT QUE DU BRUT. La troncature du titre a 60 et du chapo a 160, la
 * surcharge par `partage.seo` et le `noindex` sont CALCULES AU BUILD par
 * `src/lib/seo/metadonnees.ts`. Les appliquer ici les dupliquerait dans les deux routes
 * d article, et la copie qui derive rendrait des balises differentes d une locale a
 * l autre pour un meme contenu.
 */
import type { Article } from '../../lib/domaine.ts';
import Base from '../../layouts/Base.astro';
import PageArticle from '../../components/pages/PageArticle.astro';
import { registreDuSite } from '../../lib/routes/registre-site.ts';

export async function getStaticPaths() {
  const registre = await registreDuSite();
  return registre.articles('fr').map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const registre = await registreDuSite();
---

<Base
  titre={article.titre}
  description={article.chapo}
  page={{ genre: 'article', locale: 'fr', article }}
  seo={article.seo}
>
  <PageArticle article={article} locale="fr" registre={registre} />
</Base>
