    "mentionsLegales": [
      {
        "type": "heading",
        "level": 2,
        "children": [
          {
            "type": "text",
            "text": "What this site is"
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "\"The Highland Echo\" does not exist.",
            "bold": true
          },
          {
            "type": "text",
            "text": " This site is a technical demonstrator: it shows what a local editorial magazine can be when it is served as pure static files, with no server rendering and no JavaScript. No real local outlet publishes these articles, and this site is in no way an online press service."
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "The Hauts plateau, its 14 villages, its businesses, its associations and every figure quoted are "
          },
          {
            "type": "text",
            "text": "invented",
            "bold": true
          },
          {
            "type": "text",
            "text": " for this demonstration. The five bylines are "
          },
          {
            "type": "text",
            "text": "characters",
            "bold": true
          },
          {
            "type": "text",
            "text": ": their names, careers and biographies are fictional. No identifiable real person is named, quoted or photographed in the magazine's content, and no real company, authority or association appears in it."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "children": [
          {
            "type": "text",
            "text": "Images"
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "text": "Every visual is a "
