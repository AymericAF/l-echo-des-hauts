# Variables du build Astro. Copier en `.env` et renseigner les vraies valeurs.
#
# CE DEPOT EST PUBLIC : aucune valeur reelle ne doit entrer ici. `.env` est ignore par
# git (apps/web/.gitignore), `.env.example` ne porte que des valeurs factices.
#
# Les valeurs reelles vivent hors du depot, sous les noms exacts de la matrice des
# secrets du runbook (§13), et dans les variables de l application Coolify.

# Back-office Strapi interroge au build, et origine des medias (`/uploads/...`).
ECHO_STRAPI_URL=https://exemple.invalid

# Jeton d API Strapi en LECTURE SEULE, dedie au build (jamais un jeton full access).
# Il n est jamais expose au navigateur : il est lu cote Node, au build, et aucune
# variable de ce fichier n est prefixee PUBLIC_.
ECHO_STRAPI_API_TOKEN_READONLY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publique du site : elle sert aux canoniques et au sitemap.
ECHO_SITE_URL=https://exemple.invalid
