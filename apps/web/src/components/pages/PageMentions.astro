---
/**
 * `/mentions-legales` et `/en/mentions-legales` (§4.2).
 *
 * IL N Y A PLUS QU UNE SOURCE, ET C EST LE CHAMP STRAPI — arbitrage d Aymeric du
 * 2026-08-11, decision `ed69d5bf`, branche A : « le champ Strapi fait foi ».
 *
 * CE QUI PRECEDAIT, ET POURQUOI C ETAIT INTENABLE. Ce composant ecrivait EN DUR l editeur,
 * le directeur de la publication, le contact et l hebergeur, pendant que le champ
 * `configuration.mentionsLegales` — REQUIS par le mapping (`blocksRequis`), demande au
 * populate, seede dans les DEUX locales — n etait rendu par AUCUN composant. Deux textes
 * legaux pour un seul site, et la comparaison mot a mot n a trouve AUCUN segment commun :
 * la clause « ce site ne constitue en aucun cas un service de presse en ligne » n existait
 * que dans le dur, la provenance des images (risque R5 du brief) et la clause « aucune
 * personne reelle identifiable n est nommee » que dans le champ — et cette derniere
 * n etait donc SERVIE NULLE PART.
 *
 * Le champ porte desormais les huit clauses, recopiees mot a mot. Ce composant ne fait
 * plus que le rendre. Ce qu on gagne, au-dela de la source unique : la redaction legale se
 * corrige dans le back-office, sans commit ni build — ce que ce demonstrateur est
 * precisement cense prouver.
 *
 * LA DATE DE DERNIERE MISE A JOUR RESTE ICI, ET CE N EST PAS UN OUBLI. L option A posait
 * deux branches — la date dans le texte du champ, ou calculee sur `configuration.updatedAt`
 * (qui bouge a chaque enregistrement, meme cosmetique). Le `result` de la decision ne
 * tranche pas ce point : le comportement en place est donc CONSERVE plutot que choisi en
 * silence, et le point est remonte a Aymeric. `tests/mentions-legales.test.ts` exige
 * symetriquement qu aucune date ne vive dans le champ — deux dates finiraient par diverger.
 *
 * IL LEVE PLUTOT QUE DE SERVIR UNE PAGE MUETTE. Une Configuration absente rendrait un
 * titre, une date, et AUCUNE mention legale : une page qui a l air d une page. Succes et
 * echec rendraient la meme sortie, sur la seule page du site dont l absence de contenu
 * engage la raison sociale de l editeur. Le build echoue, et c est le point.
 *
 * Le `noindex` est CONSERVE — pose par `8a125e4` (2026-08-03) a la creation de la page, et
 * NON par `d369449`, qui n a fait que le conserver en remplissant editeur et hebergeur. Il
 * ne s ecrit plus ici : il vit dans `src/lib/seo/indexation.ts`, d ou le `<head>` et le
 * sitemap le lisent (A-29).
 */
import type { Configuration, Locale } from '../../lib/domaine.ts';
import RichTexte from '../RichTexte.astro';

interface Props {
  locale: Locale;
  /** Le Single Type `Configuration` de la locale — la SEULE source du texte legal. */
  configuration: Configuration | null;
}

const { locale, configuration } = Astro.props;

/**
 * Date de derniere mise a jour du TEXTE LEGAL lui-meme, pas du build.
 *
 * Elle bouge quand le texte bouge, et jamais autrement — c est ce qui la distingue de
 * `configuration.updatedAt`. Portee au 2026-08-11 : c est le jour ou le texte a ete
 * ramene a une source unique et complete (decision `ed69d5bf`).
 */
const derniereMiseAJour = '2026-08-11';

const TEXTES = {
  fr: { titre: 'Mentions légales', majTitre: 'Dernière mise à jour' },
  en: { titre: 'Legal notice', majTitre: 'Last updated' },
}[locale];

if (!configuration || configuration.mentionsLegales.length === 0) {
  throw new Error(
    `[PageMentions] Aucun texte legal a rendre pour la locale « ${locale} » : ` +
      `${configuration === null ? 'la Configuration est absente' : 'le champ mentionsLegales est vide'}.\n` +
      '  La page serait servie avec son titre, sa date, et AUCUNE mention legale — une page\n' +
      '  qui a l air d une page. Le build echoue plutot que de publier ce vide-la : les\n' +
      '  mentions legales engagent la raison sociale de l editeur (LCEN art. 6 III).\n' +
      '  Ceci n est PAS un defaut de redaction : verifier que le Single Type Configuration\n' +
      '  est publie dans cette locale et que le populate remonte bien `mentionsLegales`.',
  );
}
---

<div class="mentions">
  <h1>{TEXTES.titre}</h1>

  <RichTexte noeuds={configuration.mentionsLegales} />

  <p class="mentions__maj">
    <small>{TEXTES.majTitre} : {derniereMiseAJour}</small>
  </p>
</div>

<style>
  .mentions {
    max-width: var(--largeur-lecture);
  }

  .mentions__maj {
    margin-top: var(--espace-8);
    color: var(--couleur-texte-doux);
  }
</style>
