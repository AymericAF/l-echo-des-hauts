---
/**
 * Layout global. Toute page du site passe par ici.
 *
 * Ce qu il fait, et pourquoi c est ici plutot que dans chaque page :
 *   - il lit le Single Type `Configuration` de la locale demandee (une seule fois, via
 *     le Content Layer) et le passe a l en-tete et au pied de page ;
 *   - il resout la BASCULE FR/EN a partir du registre des routes emises ;
 *   - il remet le calcul de TOUTES les valeurs SEO a `src/lib/seo/metadonnees.ts`, et
 *     n en ecrit aucune lui-meme.
 *
 * LES VALEURS SEO SONT CALCULEES AU BUILD, JAMAIS STOCKEES (A-07). C est le point de
 * vigilance du lot : une valeur pre-remplie en base par un lifecycle se fige au premier
 * enregistrement, et la surcharge du component partage `partage.seo` devient un piege —
 * on ne sait plus, en lisant une entree, si ce qu on voit est un choix editorial ou le
 * fossile d un titre qui a change depuis. La chaine de repli vit donc dans le code, et
 * le harnais `tests/seo-metadonnees.test.ts` l exerce dans les deux sens.
 *
 * La bascule vit ici parce qu elle doit etre sur TOUTES les pages et parce qu elle
 * n admet qu une seule source : le registre des routes reellement emises (T-04). Chaque
 * page lui remet un DESCRIPTEUR (« je suis la page 2 de la categorie cat-1 en francais »),
 * jamais une URL — c est ce qui rend impossible la fabrication d une contrepartie par
 * prefixage, laquelle serait fausse pour toute page dont le slug differe d une locale a
 * l autre, c est-a-dire toutes (les `uid` sont localises d office, A-06).
 *
 * `hreflang` et lien de bascule ne se calculent PAS sur la meme liste (T-06) : le lien
 * est toujours rendu et peut remonter d un cran ; les alternates ne sortent que si la
 * contrepartie est EXACTE. Un `hreflang="en"` pointant une page de rubrique est une
 * erreur SEO franche.
 *
 * ZERO JavaScript : aucune balise <script>, aucun composant hydrate.
 */
import { getEntry } from 'astro:content';
import type { Locale, Seo } from '../lib/domaine.ts';
import { urlMedia } from '../lib/media.ts';
import { libelles } from '../lib/i18n/libelles.ts';
import { normaliserChemin } from '../lib/routes/chemins.ts';
import { contrepartie, type DescripteurPage } from '../lib/routes/contrepartie.ts';
import { registreDuSite } from '../lib/routes/registre-site.ts';
import { origineDuSite } from '../lib/seo/contexte-site.ts';
import { CHEMIN_FLUX } from '../lib/seo/flux.ts';
import { cheminImageOg, texteAlternatifOg } from '../lib/seo/gabarit-og.ts';
import { noindexDe } from '../lib/seo/indexation.ts';
import {
  DIMENSION_OG,
  metadonneesSeo,
  type DetailArticle,
  type ImagePartage,
} from '../lib/seo/metadonnees.ts';
import { CHEMIN_SITEMAP_INDEX } from '../lib/seo/sitemap.ts';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  /** Le titre BRUT de la page : la troncature et le suffixe sont calcules au build. */
  titre: string;
  /** La description BRUTE (chapo, description de rubrique…), avant troncature. */
  description?: string | null;
  /** Le descripteur de la page courante : la bascule s en deduit, jamais de l URL. */
  page: DescripteurPage;
  /** La surcharge editoriale `partage.seo` de l entite rendue, quand elle en porte une. */
  seo?: Seo | null;
}

const { titre, description = null, page, seo = null } = Astro.props;
const locale: Locale = page.locale;
const mots = libelles(locale);

const entree = await getEntry('configurations', locale);
const configuration = entree?.data ?? null;

const registre = await registreDuSite();
const cible = contrepartie(registre, page);

const origine = origineDuSite(Astro.site);
/* Normalise : le registre et `dist/` portent la forme sans slash final. Deux formes de
   la meme URL feraient diverger le canonique, les alternates et la garde de liens. */
const chemin = normaliserChemin(Astro.url.pathname);

/* L IMAGE DE PARTAGE, dans l ordre de priorite d A-28 :
     1. la surcharge editoriale `partage.seo.imagePartage` ;
     2. pour un ARTICLE, l image generee au build par le gabarit du §4.5 ;
     3. l `imagePartageDefaut` de la Configuration.
   Le §4.5 ne fait generer une image que « par article » : les autres pages retombent
   donc sur l image par defaut du site. */
const article = page.genre === 'article' ? page.article : null;

const imageSurchargee: ImagePartage | null = seo?.imagePartage
  ? {
      url: urlMedia(seo.imagePartage),
      largeur: seo.imagePartage.largeur,
      hauteur: seo.imagePartage.hauteur,
      alternative: seo.imagePartage.alternative,
      mime: seo.imagePartage.mime,
    }
  : null;

const imageGeneree: ImagePartage | null =
  article === null
    ? null
    : {
        url: cheminImageOg(locale, article.slug),
        largeur: DIMENSION_OG.largeur,
        hauteur: DIMENSION_OG.hauteur,
        alternative: texteAlternatifOg({
          titre: article.titre,
          rubrique: article.categorie.nom,
          auteur: article.auteur.nom,
          nomSite: configuration?.nomSite ?? '',
          couleurAccent: article.categorie.couleurAccent,
        }),
        mime: 'image/png',
      };

const imageDefaut: ImagePartage | null = configuration?.imagePartageDefaut
  ? {
      url: urlMedia(configuration.imagePartageDefaut),
      largeur: configuration.imagePartageDefaut.largeur,
      hauteur: configuration.imagePartageDefaut.hauteur,
      alternative: configuration.imagePartageDefaut.alternative,
      mime: configuration.imagePartageDefaut.mime,
    }
  : null;

const detailArticle: DetailArticle | null =
  article === null
    ? null
    : {
        datePublication: article.datePublication,
        dateModification: article.updatedAt,
        auteur: article.auteur.nom,
        rubrique: article.categorie.nom,
        etiquettes: article.tags.map((etiquette) => etiquette.nom),
      };

const meta = metadonneesSeo({
  locale,
  titre,
  description,
  nomSite: configuration?.nomSite ?? null,
  descriptionDefaut: configuration?.descriptionDefaut ?? null,
  seo,
  origine,
  chemin,
  contrepartie: cible,
  imagePartage: imageSurchargee ?? imageGeneree ?? imageDefaut,
  article: detailArticle,
  noindex: noindexDe(page, seo),
});

/* A-27 exige que la perte de reciprocite `hreflang` due a une canonique manuelle soit
   SIGNALEE, pas silencieuse. Un avertissement de build est le seul endroit ou quelqu un
   le verra : la page, elle, aura l air normale. */
for (const avertissement of meta.avertissements) console.warn(`[seo] ${avertissement}`);

const fluxDeLaLocale = new URL(CHEMIN_FLUX[locale], origine).href;
const sitemap = new URL(CHEMIN_SITEMAP_INDEX, origine).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.titre}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <link rel="canonical" href={meta.canonique} />
    {meta.alternates.map((autre) => <link rel="alternate" hreflang={autre.hreflang} href={autre.href} />)}
    {meta.noindex && <meta name="robots" content="noindex" />}
    {
      configuration?.favicon && (
        <link rel="icon" href={urlMedia(configuration.favicon)} type={configuration.favicon.mime ?? undefined} />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={mots.fluxRss} href={fluxDeLaLocale} />
    <link rel="sitemap" type="application/xml" href={sitemap} />
    {meta.og.map((balise) => <meta property={balise.property} content={balise.content} />)}
    {meta.twitter.map((balise) => <meta name={balise.name} content={balise.content} />)}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">{mots.allerAuContenu}</a>
    <EnTete configuration={configuration} locale={locale} registre={registre} bascule={cible} />
    <main id="contenu" class="contenu-principal">
      <slot />
    </main>
    <PiedDePage configuration={configuration} locale={locale} registre={registre} />
  </body>
</html>
