---
/**
 * Accueil — etat provisoire.
 *
 * La vraie page d accueil (une a la une, dernieres publications, dossiers en cours,
 * §2.1) appartient au lot des PAGES, qui n est pas encore ecrit. Cette version-ci
 * existe pour deux raisons : conserver la route, et EXERCER au build la chaine
 * complete loader → mapping → layout → en-tete/pied de page.
 *
 * Les titres ne sont volontairement pas cliquables : la route `/article/[slug]` n existe
 * pas encore, et un lien mort vaut moins qu un lien absent.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = (await getCollection('articles'))
  .filter((entree) => entree.data.locale === 'fr')
  .sort((a, b) => b.data.datePublication.localeCompare(a.data.datePublication));
---

<Base titre="Accueil">
  <h1>L Echo des Hauts</h1>

  {
    articles.length === 0 ? (
      <p>
        Aucun article n est encore publie dans Strapi. Le site se construit a partir de
        la base : tant qu elle est vide, cette page l est aussi.
      </p>
    ) : (
      <ul>
        {articles.slice(0, 10).map((entree) => (
          <li>
            <strong>{entree.data.titre}</strong> — {entree.data.categorie.nom},{' '}
            {entree.data.auteur.nom}
          </li>
        ))}
      </ul>
    )
  }
</Base>
