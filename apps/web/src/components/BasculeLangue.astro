---
/**
 * Bascule FR / EN — T-04, rendue en DEUX ELEMENTS et zero JavaScript.
 *
 * Forme imposee par l arbitrage, au mot pres : « la langue courante rendue en `<span>`
 * non cliquable porteur d `aria-current="true"`, l autre en `<a hreflang="…" lang="…">`
 * avec un libelle accessible explicite. Zero ecouteur, zero attribut `data-` interprete,
 * zero `<select>`. »
 *
 * Le lien est TOUJOURS rendu (T-06). Il ne disparait pas et ne se grise pas : un en-tete
 * dont les elements apparaissent et disparaissent d un article a l autre se lit comme une
 * panne, et fait bouger la mise en page. Quand la contrepartie exacte n existe pas, la
 * cible est le plus proche ancetre qui existe — et la perte de contexte est ANNONCEE par
 * un complement de libelle accessible, jamais subie en silence.
 *
 * L URL vient de `contrepartie()`, donc du registre des routes reellement emises. Ce
 * composant n en fabrique aucune : il n a meme pas connaissance du chemin courant.
 */
import type { Locale } from '../lib/domaine.ts';
import { libelles } from '../lib/i18n/libelles.ts';

interface Props {
  locale: Locale;
  cible: { chemin: string; locale: Locale; exact: boolean };
}

const { locale, cible } = Astro.props;

const motsCourants = libelles(locale);
/* Le libelle du lien est ecrit dans la langue de DESTINATION : c est ce que le lecteur
   qui ne lit pas la langue courante doit pouvoir comprendre. */
const motsCible = libelles(cible.locale);

const intituleCourt = { fr: 'FR', en: 'EN' } as const;
const nomDeLaCible = motsCible.nomLangue[cible.locale];
const libelleAccessible = cible.exact
  ? motsCible.versLangue(nomDeLaCible)
  : `${motsCible.versLangue(nomDeLaCible)} — ${motsCourants.traductionAbsente}`;
---

<nav class="bascule" aria-label={motsCourants.changerDeLangue}>
  <ul class="bascule__liste">
    <li>
      <span class="bascule__courante" aria-current="true" lang={locale}>
        {intituleCourt[locale]}
        <span class="hors-ecran">— {motsCourants.langueCourante}</span>
      </span>
    </li>
    <li>
      <a
        class="bascule__lien"
        href={cible.chemin}
        hreflang={cible.locale}
        lang={cible.locale}
      >
        {intituleCourt[cible.locale]}
        <span class="hors-ecran">— {libelleAccessible}</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  .bascule__liste {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--taille-s);
    font-weight: var(--graisse-forte);
    letter-spacing: 0.04em;
  }

  .bascule__liste li + li {
    border-left: var(--bordure-fine);
    padding-left: var(--espace-2);
  }

  .bascule__courante {
    color: var(--couleur-texte-doux);
  }

  .bascule__lien {
    color: var(--couleur-lien);
  }
</style>
