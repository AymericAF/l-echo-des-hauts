            {
              "type": "heading",
              "level": 2,
              "children": [
                {
                  "type": "text",
                  "text": "Eighteen months of detours"
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The first vehicle crossed the structure at 6.12 am, to the applause of some thirty residents who had come out despite the cold."
                }
              ]
            },
            {
              "type": "heading",
              "level": 3,
              "children": [
                {
                  "type": "text",
                  "text": "What the works changed"
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The approaches have been widened, and the upstream pavement now makes it possible to cross on foot."
                }
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "children": [
                {
                  "type": "text",
                  "text": "What is still to come"
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The cycle footbridge, dropped from the original contract, is waiting on funding from the department."
                }
              ]
            }
          ]
        },
        {
          "__component": "bloc.citation",
          "id": 152,
          "texte": "We had got used to the detour in the end, but nobody will miss it.",
          "auteurCitation": "Helene Bouvier",
