---
/**
 * `/` — accueil francais (§4.2 : article a la une, derniers articles, selection par
 * rubrique, dossiers en cours).
 *
 * Fichier de ROUTE : il ne fait qu emettre le chemin et remettre le rendu a
 * `PageAccueil`, que `/en/` partage. Le titre de la balise `<title>` vient du nom du
 * site, ajoute par le layout.
 */
import Base from '../layouts/Base.astro';
import PageAccueil from '../components/pages/PageAccueil.astro';
import { libelles } from '../lib/i18n/libelles.ts';
import { registreDuSite } from '../lib/routes/registre-site.ts';

const registre = await registreDuSite();
---

<Base titre={libelles('fr').accueil} page={{ genre: 'accueil', locale: 'fr' }}>
  <PageAccueil locale="fr" registre={registre} />
</Base>
