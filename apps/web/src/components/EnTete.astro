---
/**
 * En-tete global, alimente par le Single Type `Configuration` (§3.8).
 *
 * A-35 : `logo` et `logoSombre` sont servis par un <picture> avec
 * `media="(prefers-color-scheme: dark)"`. Pas de bouton de bascule — il exigerait de
 * lire un choix persiste avant peinture, donc du JavaScript sur toutes les pages, ce
 * que la §1 interdit sans amendement possible.
 *
 * Quand `configuration` vaut null (aucune entree en base), l en-tete le DIT au lieu de
 * ressembler a un en-tete fini : un gabarit muet ferait passer une base vide pour un
 * site en ordre de marche.
 *
 * §5.3 — `loading="eager"` sur le logo, ECRIT et non laisse au defaut. Le logo est la
 * premiere chose de la zone visible immediate : c est exactement l image que le §5.3
 * exclut du chargement differe. L attribut est explicite parce que la garde §5.3
 * (`integrations/garde-images.mjs`) refuse un `<img>` muet — un attribut absent ne dit
 * pas laquelle des deux intentions on avait, et le mode d echec couteux n est pas le
 * `lazy` oublie, c est le `lazy` pose ici, qui retarderait la premiere peinture.
 *
 * Le `<source>` porte SES PROPRES dimensions : il sert un autre fichier que l `<img>`,
 * et si son rapport de forme differe, la boite reservee d apres l `<img>` n est pas la
 * sienne — l image sombre arriverait dans une boite qui n est pas la sienne, et le CLS
 * reviendrait par le seul chemin que le §5.3 ne nomme pas.
 */
import type { Configuration, Locale } from '../lib/domaine.ts';
import { urlMedia } from '../lib/media.ts';
import { libelles } from '../lib/i18n/libelles.ts';
import { cheminAccueil } from '../lib/routes/chemins.ts';
import type { Contrepartie } from '../lib/routes/contrepartie.ts';
import type { Registre } from '../lib/routes/registre.ts';
import BasculeLangue from './BasculeLangue.astro';
import Navigation from './Navigation.astro';

interface Props {
  configuration: Configuration | null;
  locale: Locale;
  registre: Registre;
  /** Deja resolue par le layout : l en-tete ne calcule aucune URL de contrepartie (T-04). */
  bascule: Contrepartie;
}

const { configuration, locale, registre, bascule } = Astro.props;
const accueil = cheminAccueil(locale);
const mots = libelles(locale);
/** Le nom du Single Type de Strapi — un identifiant du modele, jamais un mot a traduire. */
const SINGLE_TYPE = 'Configuration';
---

<header class="en-tete">
  {
    configuration === null ? (
      <p class="bandeau-gabarit">{mots.configurationAbsente(SINGLE_TYPE)}</p>
    ) : (
      <div class="en-tete__interieur">
        <a class="en-tete__marque" href={accueil}>
          {configuration.logoSombre ? (
            <picture>
              <source
                srcset={urlMedia(configuration.logoSombre)}
                media="(prefers-color-scheme: dark)"
                width={configuration.logoSombre.largeur ?? undefined}
                height={configuration.logoSombre.hauteur ?? undefined}
              />
              <img
                src={urlMedia(configuration.logo)}
                alt={configuration.logo.alternative ?? configuration.nomSite}
                width={configuration.logo.largeur ?? undefined}
                height={configuration.logo.hauteur ?? undefined}
                loading="eager"
                decoding="async"
              />
            </picture>
          ) : (
            <img
              src={urlMedia(configuration.logo)}
              alt={configuration.logo.alternative ?? configuration.nomSite}
              width={configuration.logo.largeur ?? undefined}
              height={configuration.logo.hauteur ?? undefined}
              loading="eager"
              decoding="async"
            />
          )}
          <span class="hors-ecran">{configuration.nomSite}</span>
        </a>

        {configuration.baseline && <p class="en-tete__baseline">{configuration.baseline}</p>}

        <div class="en-tete__bascule">
          <BasculeLangue locale={locale} cible={bascule} />
        </div>
      </div>
    )
  }

  <div class="en-tete__navigation">
    <Navigation locale={locale} registre={registre} />
  </div>
</header>

<style>
  .en-tete {
    background: var(--couleur-surface);
    border-bottom: var(--bordure-fine);
  }

  .en-tete__interieur {
    width: min(100% - 2 * var(--espace-4), var(--largeur-page));
    margin-inline: auto;
    padding-block: var(--espace-4);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--espace-2) var(--espace-6);
  }

  /*
   * §5.3 — `height` DEFINIE, jamais `max-height`. Ce n est pas une preference de style,
   * c est ce qui reserve la boite du logo avant qu il n arrive.
   *
   * MESURE, pas deduction (banc Chrome headless, 2026-08-07, article servi avec 900 ms de
   * retard sur les medias) : avec `max-height: 3rem` + `width: auto`, et le
   * `img { height: auto }` du reset de `styles/base.css`, les DEUX axes etaient en `auto`
   * — le navigateur ne pouvait alors deriver aucune boite des attributs `width`/`height`
   * et posait l image a **0 x 0**. Le logo arrivait, l en-tete passait de 57 a 88 px, et
   * toute la page descendait : **CLS = 0,0554**, un seul decalage, sources
   * `main#contenu` et `p.en-tete__baseline`. Apres ce correctif : **CLS = 0**.
   *
   * La lecon generale, qui vaut pour toute image ajoutee plus tard : les attributs
   * `width`/`height` ne reservent rien tant que la CSS laisse les deux axes en `auto`.
   * Il en faut UN de defini — ici `height`, ailleurs le `width: 100%` des blocs. La garde
   * §5.3 lit le HTML : elle ne peut pas voir cette classe-la, seule une mesure la voit.
   */
  .en-tete__marque img {
    display: block;
    height: 3rem;
    width: auto;
  }

  .en-tete__baseline {
    margin: 0;
    color: var(--couleur-texte-doux);
    font-size: var(--taille-s);
  }

  /* La bascule est poussee a droite : elle est la meme sur toutes les pages, et sa
     position stable est ce qui l empeche de se lire comme un element qui apparait. */
  .en-tete__bascule {
    margin-inline-start: auto;
  }

  .en-tete__navigation {
    width: min(100% - 2 * var(--espace-4), var(--largeur-page));
    margin-inline: auto;
    padding-block: var(--espace-2) var(--espace-3);
  }
</style>
